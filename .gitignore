# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenv
venv/
.venv/

# Local state: the persistent ID store + record cache. Rebuildable via uplers_sync_index().
data/
*.sqlite3
*.sqlite3-journal

# Secrets. The authenticated tier stores a live bearer token, so these are
# named explicitly as well as being covered by `data/` above: the data dir is
# relocatable via UPLERS_DATA_DIR, and a credential should not depend on one
# line staying put.
.env
.env.*
session.json
browser_profile/

# Optional redaction salt. `scripts/capture_outreach.py` substitutes opaque
# handles with a one-way, shape-preserving hash of the original. The tracked
# default salt is deliberately NOT a secret - destruction, not reversibility,
# is the point - but a published salt leaves the SHORT digit-shaped handles
# (a seven-digit account id has only 10^7 candidates) recoverable by brute
# force. Drop one line of text here before a re-derivation and that class
# becomes unrecoverable too. Untracked for the same reason a key is.
scripts/.redaction_salt

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
