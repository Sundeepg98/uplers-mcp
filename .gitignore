# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtualenv
venv/
.venv/

# Local state: the persistent ID store + record cache. Rebuildable via uplers_sync_index().
data/
*.sqlite3
*.sqlite3-journal

# Secrets. The authenticated tier stores a live bearer token, so these are
# named explicitly as well as being covered by `data/` above: the data dir is
# relocatable via UPLERS_DATA_DIR, and a credential should not depend on one
# line staying put.
.env
.env.*
session.json
browser_profile/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
